<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_nav_backup"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/lw_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="@string/backup_subtitle"
            android:textSize="12sp"
            android:textColor="@color/lw_text_secondary" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/lw_bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/backup_header"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/lw_text_accent"
                    android:layout_marginBottom="12dp" />

                <!-- Export -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/backup_export_title"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/lw_text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/backup_export_desc"
                            android:textSize="11sp"
                            android:textColor="@color/lw_text_secondary" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnExportSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="@string/backup_btn_export"
                        android:textSize="12sp"
                        android:textColor="@color/lw_btn_solid_text"
                        android:backgroundTint="@color/lw_accent_primary"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/lw_divider" />

                <!-- Import -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/backup_import_title"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/lw_text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/backup_import_desc"
                            android:textSize="11sp"
                            android:textColor="@color/lw_text_secondary" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnImportSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="@string/backup_btn_import"
                        android:textSize="12sp"
                        android:textColor="@color/lw_btn_outline_text"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:strokeColor="@color/lw_btn_outline_stroke"
                        app:cornerRadius="8dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/lw_divider" />

                <!-- Reset Defaults -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/backup_reset_title"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#EF4444" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/backup_reset_desc"
                            android:textSize="11sp"
                            android:textColor="@color/lw_text_secondary" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnResetDefaults"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="@string/backup_btn_reset"
                        android:textSize="12sp"
                        android:textColor="#EF4444"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:strokeColor="#EF4444"
                        app:cornerRadius="8dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>

                <!-- Last Action Status Log -->
                <TextView
                    android:id="@+id/tvBackupStatusLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_status"
                    android:padding="10dp"
                    android:textSize="11sp"
                    android:textColor="@color/lw_text_secondary"
                    android:text="@string/backup_status_ready" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
