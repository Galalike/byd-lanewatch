<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_nav_settings"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/lw_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="@string/settings_subtitle"
            android:textSize="12sp"
            android:textColor="@color/lw_text_secondary" />

        <!-- Card: Appearance & Navigation Position -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/lw_bg_card"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_nav_appearance_header"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/lw_text_accent"
                    android:layout_marginBottom="12dp" />

                <!-- Steering Position Selector -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_sidebar_pos_title"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/lw_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_sidebar_pos_desc"
                    android:textSize="11sp"
                    android:textColor="@color/lw_text_secondary"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rgSteeringPos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <RadioButton
                        android:id="@+id/rbSteerAuto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_steer_auto"
                        android:textSize="12sp"
                        android:textColor="@color/lw_text_primary"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbSteerRhd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/settings_steer_rhd"
                        android:textSize="12sp"
                        android:textColor="@color/lw_text_primary" />

                    <RadioButton
                        android:id="@+id/rbSteerLhd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/settings_steer_lhd"
                        android:textSize="12sp"
                        android:textColor="@color/lw_text_primary" />
                </RadioGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/lw_divider" />

                <!-- AVM Camera ID Selector (Fix for BYD Dolphin / Atto 1 / Qin Plus) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_avm_cam_id_title"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/lw_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_avm_cam_id_desc"
                    android:textSize="11sp"
                    android:textColor="@color/lw_text_secondary"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rgCamId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <RadioButton
                        android:id="@+id/rbCamAuto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_avm_cam_auto"
                        android:textSize="12sp"
                        android:textColor="@color/lw_text_primary"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbCam1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/settings_avm_cam_1"
                        android:textSize="12sp"
                        android:textColor="@color/lw_text_primary" />

                    <RadioButton
                        android:id="@+id/rbCam0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/settings_avm_cam_0"
                        android:textSize="12sp"
                        android:textColor="@color/lw_text_primary" />
                </RadioGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/lw_divider" />

                <!-- Language and Theme Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Language -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_lang_title"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/lw_text_primary"
                            android:layout_marginBottom="6dp" />

                        <Spinner
                            android:id="@+id/spinnerSettingsLang"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_spinner_box" />
                    </LinearLayout>

                    <!-- Theme -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_theme_title"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/lw_text_primary"
                            android:layout_marginBottom="6dp" />

                        <Spinner
                            android:id="@+id/spinnerSettingsTheme"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_spinner_box" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card: Autostart & Service Behavior -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/lw_bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_system_header"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/lw_text_accent"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_autostart_title"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/lw_text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_autostart_desc"
                            android:textSize="11sp"
                            android:textColor="@color/lw_text_secondary" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnRunAutostartSync"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="@string/settings_btn_run_autostart"
                        android:textSize="12sp"
                        android:textColor="@color/lw_btn_solid_text"
                        android:backgroundTint="@color/lw_accent_primary"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
