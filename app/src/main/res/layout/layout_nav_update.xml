<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_nav_update"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/lw_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/update_subtitle"
                    android:textSize="12sp"
                    android:textColor="@color/lw_text_secondary" />
            </LinearLayout>

            <Switch
                android:id="@+id/swAutoCheckUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/update_auto_check"
                android:textSize="12sp"
                android:textColor="@color/lw_text_secondary"
                android:checked="true" />

            <Button
                android:id="@+id/btnConfigureOta"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="@string/update_btn_config_ota"
                android:textSize="12sp"
                android:textColor="@color/lw_btn_outline_text"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeColor="@color/lw_btn_outline_stroke"
                app:cornerRadius="8dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>

        <!-- Version Status Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/lw_bg_card"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Version Info Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvUpdateCurrentVer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/update_cur_ver_label"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/lw_text_primary" />

                        <TextView
                            android:id="@+id/tvUpdateLatestVer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/update_latest_ver_label"
                            android:textSize="12sp"
                            android:textColor="@color/lw_text_secondary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvUpdateStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/update_status_not_checked"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/lw_text_secondary"
                        android:background="@drawable/bg_status"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/lw_divider" />

                <!-- Details Grid (Channel, Last Checked, Release Date, Size) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/update_channel_label"
                            android:textSize="11sp"
                            android:textColor="@color/lw_text_secondary" />

                        <Spinner
                            android:id="@+id/spinnerUpdateChannel"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_spinner_box" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/update_last_checked_label"
                            android:textSize="11sp"
                            android:textColor="@color/lw_text_secondary" />

                        <TextView
                            android:id="@+id/tvUpdateLastChecked"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="-"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/lw_text_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/update_release_date_label"
                            android:textSize="11sp"
                            android:textColor="@color/lw_text_secondary" />

                        <TextView
                            android:id="@+id/tvUpdateReleaseDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="-"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/lw_text_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/update_size_label"
                            android:textSize="11sp"
                            android:textColor="@color/lw_text_secondary" />

                        <TextView
                            android:id="@+id/tvUpdateSize"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="-"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/lw_text_primary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Progress Section -->
                <LinearLayout
                    android:id="@+id/layoutUpdateProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/pbUpdateProgress"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:indeterminate="false"
                        android:progress="0" />

                    <TextView
                        android:id="@+id/tvUpdateProgressText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Downloading..."
                        android:textSize="11sp"
                        android:textColor="@color/lw_text_accent" />
                </LinearLayout>

                <!-- Error Container -->
                <LinearLayout
                    android:id="@+id/layoutUpdateError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="14dp"
                    android:background="#15EF4444"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️ Error / Failure"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#EF4444" />

                    <TextView
                        android:id="@+id/tvUpdateErrorMsg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="-"
                        android:textSize="11sp"
                        android:textColor="@color/lw_text_primary" />
                </LinearLayout>

                <!-- Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCheckOtaUpdate"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:text="@string/update_btn_check"
                        android:textSize="13sp"
                        android:textColor="@color/lw_btn_solid_text"
                        android:backgroundTint="@color/lw_accent_primary"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="10dp" />

                    <Button
                        android:id="@+id/btnDownloadUpdate"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="12dp"
                        android:text="@string/update_btn_download"
                        android:textSize="13sp"
                        android:textColor="@color/lw_btn_outline_text"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:strokeColor="@color/lw_btn_outline_stroke"
                        app:cornerRadius="10dp"
                        android:visibility="gone"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                    <Button
                        android:id="@+id/btnInstallUpdate"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="12dp"
                        android:text="@string/update_btn_install"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#16A34A"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="10dp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnRetryUpdate"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="12dp"
                        android:text="@string/update_btn_retry"
                        android:textSize="13sp"
                        android:textColor="@color/lw_btn_outline_text"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:strokeColor="@color/lw_btn_outline_stroke"
                        app:cornerRadius="10dp"
                        android:visibility="gone"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Release Notes Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/lw_bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/update_release_notes_header"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/lw_text_accent"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tvUpdateChangelog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/lw_text_secondary"
                    android:lineSpacingExtra="4dp"
                    android:text="• [New] Automotive OEM Infotainment UI with Adaptive Navigation\n• [New] LHD / RHD Adaptive Steering wheel placement support\n• [New] Automatic DiLink Autostart restriction bypass on update\n• [Improved] ADAS BSD Radar red alert frame on PiP in real-time\n• [Fix] Aspect ratio stretching in Hazard and Rearview modes" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
